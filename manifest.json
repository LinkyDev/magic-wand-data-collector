{
  "manifest_version": 2,
  "name": "Magic Wand Data Collector",
  "version": "0.1.0",
  "description": "Assist manual data collection from CSV-driven URL lists with an interactive magic wand UI.",
  "icons": {
    "16": "magic-wand-icon.png",
    "32": "magic-wand-icon.png",
    "48": "magic-wand-icon.png",
    "128": "magic-wand-icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Magic Wand Collector",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "magic-wand-icon.png",
      "32": "magic-wand-icon.png",
      "48": "magic-wand-icon.png"
    }
  },
  "web_accessible_resources": [
    "content/contentStyles.css"
  ]
}
